# ============================================================================
# Connection settings for a production-style deployment.
#
# ONLY the "Orders database" block below is read by the application, and only
# when STORAGE=postgres (default is STORAGE=memory: no database at all).
# Every other block is a PROPOSAL for future adapters and is ignored today.
# See docs/architecture.md ("4b. Database connections").
#
# Values are placeholders; never commit real credentials. In production load
# them from a secrets manager (AWS Secrets Manager, Vault) instead of a file.
#
# Node 20.6+ can load a file with:  node --env-file=.env dist/main.js
# ============================================================================

# --- Orders database (PostgreSQL) - IMPLEMENTED (STORAGE=postgres) ---------
# Needs write access.
STORAGE=postgres
ORDERS_DB_URL=postgresql://orders_app:CHANGE_ME@orders-db.internal:5432/orders
ORDERS_DB_POOL_MAX=10
ORDERS_DB_CONNECT_TIMEOUT_MS=3000
ORDERS_DB_QUERY_TIMEOUT_MS=5000
ORDERS_DB_SSL=true
# Create the orders table at startup (dev only; use migrations in production).
ORDERS_DB_AUTO_SCHEMA=false
# FUTURE (not read yet): optional read replica for GET /orders history queries.
# ORDERS_DB_READ_URL=postgresql://orders_ro:CHANGE_ME@orders-db-replica.internal:5432/orders

# --- Portfolio database (PostgreSQL) - implements PortfolioProvider ---------
# Read-only account. Separate database, pool and credentials from orders.
PORTFOLIO_DB_URL=postgresql://portfolio_ro:CHANGE_ME@portfolio-db.internal:5432/portfolios
PORTFOLIO_DB_POOL_MAX=5
PORTFOLIO_DB_CONNECT_TIMEOUT_MS=3000
PORTFOLIO_DB_QUERY_TIMEOUT_MS=2000
PORTFOLIO_DB_SSL=true

# --- Pricing store (MongoDB) - implements PricingProvider -------------------
# Or replace with a market-data HTTP API (next block).
PRICING_DB_URI=mongodb://pricing_ro:CHANGE_ME@pricing-db.internal:27017/pricing?replicaSet=rs0&tls=true
PRICING_DB_NAME=pricing
PRICING_DB_POOL_MAX=10
PRICING_DB_CONNECT_TIMEOUT_MS=3000
PRICING_DB_QUERY_TIMEOUT_MS=1500

# --- Market-data API (alternative PricingProvider over HTTP) ----------------
MARKET_DATA_BASE_URL=https://market-data.example.com/v1
MARKET_DATA_API_KEY=CHANGE_ME
MARKET_DATA_TIMEOUT_MS=1500
MARKET_DATA_RETRIES=2
# Reject prices older than this instead of guessing.
MARKET_DATA_MAX_PRICE_AGE_SECONDS=60

# --- Exchange calendar API - implements MarketCalendarProvider --------------
CALENDAR_API_BASE_URL=https://calendar.example.com/v1
CALENDAR_API_KEY=CHANGE_ME
CALENDAR_API_TIMEOUT_MS=1500
# Holidays change rarely, so caching is safe here.
CALENDAR_CACHE_TTL_SECONDS=3600

# --- Cache (Redis) - optional, only for data that tolerates staleness -------
REDIS_URL=rediss://:CHANGE_ME@cache.internal:6379/0
REDIS_CONNECT_TIMEOUT_MS=2000

# --- Message broker - only if order execution becomes asynchronous ----------
# Pick ONE (see the Kafka / RabbitMQ / SQS guide in docs/architecture.md).
# SQS (AWS)
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/order-requests
# AWS_REGION=us-east-1
# RabbitMQ
# RABBITMQ_URL=amqps://orders:CHANGE_ME@mq.internal:5671
# RABBITMQ_QUEUE=order-requests
# Kafka
# KAFKA_BROKERS=kafka-1.internal:9093,kafka-2.internal:9093
# KAFKA_CLIENT_ID=order-splitter
# KAFKA_TOPIC=order-requests

# --- Shared resilience settings ---------------------------------------------
# Total time budget for one API request across all remote calls.
REQUEST_TIMEOUT_MS=8000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30
