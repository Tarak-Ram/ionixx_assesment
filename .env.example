# --- Runtime ---
# development | test | production. In production: AUTH_MODE=none and ORDERS_DB_AUTO_SCHEMA=true
# are refused at startup, and Swagger UI is off unless SWAGGER_ENABLED=true.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent  (logs are JSON on stdout)
LOG_LEVEL=info

# --- Business configuration ---
# Max decimal places allowed for share quantities (0-10). 3 today, 7 later.
SHARE_PRECISION=3
# Price used when the partner does not supply a market price.
DEFAULT_PRICE=100
# IANA timezone used to decide the weekday of a request (e.g. America/New_York).
MARKET_TIMEZONE=UTC

# Memory guard for the in-memory history: oldest orders are dropped beyond this many.
MAX_STORED_ORDERS=10000

# --- HTTP hardening ---
# Comma separated browser origins allowed to call the API. Empty = no cross-origin access.
# CORS_ORIGINS=https://app.example.com
# Number of reverse proxies / load balancers in front of the app (for the real client IP).
TRUST_PROXY_HOPS=0
# Rate limit per client IP: RATE_LIMIT_MAX requests per RATE_LIMIT_TTL_MS window (429 beyond).
RATE_LIMIT_MAX=300
RATE_LIMIT_TTL_MS=60000
# Swagger UI at /docs (default: on in development, off in production).
# SWAGGER_ENABLED=true
# Prometheus endpoint at /api/v1/metrics. It is unauthenticated: keep it on the internal network.
METRICS_ENABLED=true

# --- Storage ---
# memory   = history kept in process memory, lost on restart (challenge behaviour, default)
# postgres = history stored in PostgreSQL (optional; requires the ORDERS_DB_* settings below)
STORAGE=memory
# ORDERS_DB_URL=postgresql://orders_app:orders_pw@localhost:5432/orders
# ORDERS_DB_POOL_MAX=10
# ORDERS_DB_CONNECT_TIMEOUT_MS=3000
# ORDERS_DB_QUERY_TIMEOUT_MS=5000
# ORDERS_DB_SSL=false
# PEM CA bundle to trust when ORDERS_DB_SSL=true (use \n for line breaks), e.g. the cloud provider's CA.
# ORDERS_DB_SSL_CA=
# Startup connection retries with exponential backoff (delay doubles each attempt).
# ORDERS_DB_CONNECT_RETRIES=5
# ORDERS_DB_CONNECT_RETRY_DELAY_MS=500
# ORDERS_DB_AUTO_SCHEMA=true

# --- Authentication (optional; the challenge does not require it) ---
# none | api-key | jwt
AUTH_MODE=none
# api-key mode: comma separated "key:partnerId" pairs
# API_KEYS=demo-key-partner-a:partner-a,demo-key-partner-b:partner-b
# jwt mode: HS256 secret (min 32 chars). Partner id is read from the "sub" claim.
# A "scope" claim (space separated) is enforced when present: orders:write for POST, orders:read for GET.
# JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# JWT_ISSUER=
# JWT_AUDIENCE=
